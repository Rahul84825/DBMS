# Smart Farm DBMS Backend — Example Configuration
# Copy this file to .env and configure your local MySQL credentials.

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_farm_db
DB_CONNECTION_LIMIT=10

# Security / Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Illustrative Demo Soil Moisture Alert Threshold (%)
DEFAULT_MOISTURE_ALERT_THRESHOLD=30.0
